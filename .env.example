# Copy to .env and adjust. Values here are also read from the process
# environment, which takes priority.
#
# If you run the MiniMax-H3-DGX-Spark deployment repo, its .env already holds
# H3_API_BASE and H3_API_KEY and is picked up automatically — you only need a
# local .env to override something.

# Where vLLM-Omni is listening. A trailing /v1 is stripped for you.
H3_API_BASE=http://127.0.0.1:8000

# One queue in front of several machines, each running its own server. Set this
# rather than a comma separated H3_API_BASE when the deployment repo shares the
# file. See "More than one box" in the README.
#H3_API_BASES=http://spark-a.lan:8002,http://spark-b.lan:8002

# Required when the server was started with an API key. Generate with:
#   openssl rand -hex 32
H3_API_KEY=

# UI bind address. Loopback by default — serving on a LAN address also exposes
# whatever the browser can reach through this process, so widen it on purpose.
H3_UI_HOST=127.0.0.1
H3_UI_PORT=8080

# Which request contract the upstream speaks. "current" is the 2026-08-22
# nightly and later: t2va needs a named aspect_ratio, and the clip has to be
# 4 to 15 seconds. "legacy" is the minimax-h3 image from 2026-08-02.
#H3_SERVER_CONTRACT=current

# FastH3. The server fuses the adapter at load time from --lora-path and says
# nothing about it on the wire, so h3-ui has to be told. Setting either of
# these locks the steps box to 4, drops both shift fields from the request and
# narrows the mode list to t2va. Every configured upstream must be running it.
#H3_LORA_PATH=/models/fasth3/dense-datafree/adapter_model.safetensors
# Override: a switch, or the step count the adapter pins. 0 forces it off.
#H3_FASTH3=4

# Time estimate coefficients, in terms of X = megapixels * seconds of output:
#   t = FIXED + PER_MPXS*X + PER_MPXS_STEP*X*steps + PER_MPXS2_STEP*X^2*steps
# The defaults were fitted to 11 timed renders on a DGX Spark (GB10) with no
# Cache-DiT. They describe that box, not h3-ui: see "Recalibrating the time
# estimate" in the README before changing them.
#H3_EST_FIXED_SECONDS=0
#H3_EST_PER_MPXS=11.88
#H3_EST_PER_MPXS_STEP=6.05
#H3_EST_PER_MPXS2_STEP=0.88

# A LoRA the server preloaded with --lora-backend peft --lora-path and left
# inactive. Setting the path here makes the checkbox appear; ticking it sends a
# `lora` field and the adapter's own sampling settings. Mutually exclusive with
# a fused FastH3 server, which refuses requests that name a LoRA.
# Upstream supports exactly one artifact:
#   lightx2v/Minimax-h3-Turbo/minimax_h3_fl2v_turbo_4step_v1.0_768p_bf16.safetensors
#H3_REQUEST_LORA_PATH=/models/turbo/minimax_h3_fl2v_turbo_4step_v1.0_768p_bf16.safetensors
#H3_REQUEST_LORA_NAME=h3-turbo-v1.0
#H3_REQUEST_LORA_LABEL=Turbo, 4 denoiser steps
#H3_REQUEST_LORA_STEPS=5
#H3_REQUEST_LORA_FLOW_SHIFT=6
#H3_REQUEST_LORA_AUDIO_SHIFT=3.0
#H3_REQUEST_LORA_SCALE=1.0
#H3_REQUEST_LORA_TASKS=t2va,fl2va
