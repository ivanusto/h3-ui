# Copy to .env and adjust. Values here are also read from the process
# environment, which takes priority.
#
# If you run the MiniMax-H3-DGX-Spark deployment repo, its .env already holds
# H3_API_BASE and H3_API_KEY and is picked up automatically — you only need a
# local .env to override something.

# Where vLLM-Omni is listening. A trailing /v1 is stripped for you.
H3_API_BASE=http://127.0.0.1:8000

# Required when the server was started with an API key. Generate with:
#   openssl rand -hex 32
H3_API_KEY=

# UI bind address. Loopback by default — serving on a LAN address also exposes
# whatever the browser can reach through this process, so widen it on purpose.
H3_UI_HOST=127.0.0.1
H3_UI_PORT=8080
